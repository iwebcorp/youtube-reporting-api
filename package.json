{
  "name": "kwangsoo-youtube-settlement",
  "version": "1.0.0",
  "description": "광수미디어 YouTube 월별 정산 데이터 생성 도구",
  "scripts": {
    "start": "npm run gui",
    "typecheck": "tsc --noEmit",
    "get-reports": "tsx src/getReports.ts",
    "extract-csv": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs src/extractCsvs.ts",
    "extract-pub": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs src/extractPublishingCsvs.ts",
    "extract-client-package": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs src/extractMonthlyClientPackage.ts",
    "extract-settlement-summary": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs src/extractApiSettlementSummary.ts",
    "extract-publishing-shorts": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs src/extractPublishingShortsSummary.ts",
    "extract-publishing-ge": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs src/extractPublishingGeSummary.ts",
    "monthly-settlement": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs src/runMonthlySettlement.ts",
    "extract-shorts-song-data": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs src/extractShortsSongData.ts",
    "enrich-shorts-song-data": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs src/enrichShortsSongData.ts",
    "validate-settlement-package": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs src/validateSettlementPackage.ts",
    "download-system-managed": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs src/downloadSystemManagedReports.ts",
    "gui": "node ./node_modules/tsx/dist/cli.mjs src/guiServer.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "csv-parse": "^6.2.1",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "iconv-lite": "^0.7.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3"
  }
}
